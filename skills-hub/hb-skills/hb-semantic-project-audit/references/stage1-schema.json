{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_count", "readme_alignment", "candidate_pairs", "notes"],
  "properties": {
    "project_count": { "type": "integer", "minimum": 0 },
    "readme_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "status", "reason", "evidence"],
        "properties": {
          "project": { "type": "string" },
          "status": { "type": "string", "enum": ["aligned", "stale", "not_assessable"] },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "start_line", "end_line"],
              "properties": {
                "path": { "type": "string" },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "candidate_pairs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projects", "suspected_checks", "reason", "evidence"],
        "properties": {
          "projects": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "suspected_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["work_identity", "boundary_integrity", "drift_risk"] } },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "start_line", "end_line"],
              "properties": {
                "path": { "type": "string" },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
