{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/local-lifecycle.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Write$|^Edit$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/local-lifecycle.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^Bash$|^exec_command$|^functions\\.exec$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/pre-delivery.mjs\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^apply_patch$|^Write$|^Edit$|^Bash$|^exec_command$|^functions\\.exec$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-policy/brain-checkout-freshness.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Write$|^Edit$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/local-lifecycle.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^Read$|^WebFetch$|^mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/evidence-observer.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/local-lifecycle.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Read$|^WebFetch$|^mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/evidence-observer.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
